{
  "ci": {
    "collect": {
      "startServerCommand": "npm --prefix website run preview -- --port 4321",
      "startServerReadyPattern": "4321",
      "url": [
        "http://localhost:4321/sciproof/",
        "http://localhost:4321/sciproof/docs/getting-started/",
        "http://localhost:4321/sciproof/docs/cli-reference/"
      ],
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./lhci-results" }
  }
}
