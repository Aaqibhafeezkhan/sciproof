---
// Contributors, maintainers and live repository numbers.
// Build time: scripts/sync.mjs writes data/community.json from the GitHub API (authenticated in CI),
// copies avatars onto this site, and reads MAINTAINERS.md. Browser: refreshes the numbers from the
// unauthenticated GitHub REST API and silently keeps the build-time values if that fails.
import community from '../data/community.json';
import pypi from '../data/pypi.json';
import { REPO, REPO_URL } from '../../site.config.mjs';

const fetchedAt = community.fetchedAt;
const num = (v: number | null | undefined) => (typeof v === 'number' ? String(v) : '–');
---

<section class="lp-section" id="community">
  <div class="lp-wrap">
    <h2>Community</h2>
    <p class="lp-lead">
      SciProof is an open-source project. These numbers are read from GitHub; they were captured when the site was built and
      refresh in your browser if GitHub's API answers.
    </p>

    <div class="lp-stats" data-community data-repo={REPO} aria-label="Repository statistics">
      <div class="lp-stat"><strong data-stat="stars">{num(community.repo?.stars)}</strong><span>stars</span></div>
      <div class="lp-stat"><strong data-stat="forks">{num(community.repo?.forks)}</strong><span>forks</span></div>
      <div class="lp-stat"><strong data-stat="issues">{num(community.repo?.openIssues)}</strong><span>open issues and PRs</span></div>
      <div class="lp-stat">
        <strong data-stat="release">{community.release ? community.release.tag : 'none yet'}</strong><span>latest release</span>
      </div>
      {
        pypi.published && (
          <div class="lp-stat">
            <strong>{pypi.version}</strong><span>on PyPI</span>
          </div>
        )
      }
    </div>
    <p class="lp-note">
      {
        fetchedAt ? (
          <>
            Updated <time id="community-updated" datetime={fetchedAt}>{fetchedAt.slice(0, 16).replace('T', ' ')} UTC</time>.
          </>
        ) : (
          <>The statistics could not be loaded when the site was built.</>
        )
      }
      Your browser contacts <code>api.github.com</code> to refresh them; no cookies are set and nothing else is sent.
    </p>

    <h3>Contributors</h3>
    {
      community.contributors.length ? (
        <ul class="lp-people" id="contributors">
          {community.contributors.map((c) => (
            <li class="lp-person" data-login={c.login}>
              {c.localAvatar ? (
                <img src={c.localAvatar} alt="" width="42" height="42" loading="lazy" />
              ) : (
                <span class="ph" aria-hidden="true">{c.login.slice(0, 1).toUpperCase()}</span>
              )}
              <span>
                <a href={c.url}>{c.login}</a>
                <small><span data-count>{c.contributions}</span> contributions</small>
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p>
          The contributor list could not be loaded when the site was built. See
          <a href={`${REPO_URL}/graphs/contributors`}> the contributors graph on GitHub</a>.
        </p>
      )
    }

    <h3>Maintainers</h3>
    {
      community.maintainers.length ? (
        <ul class="lp-people">
          {community.maintainers.map((m) => (
            <li class="lp-person">
              <span class="ph" aria-hidden="true">{m.login.slice(0, 1).toUpperCase()}</span>
              <span>
                <a href={`https://github.com/${m.login}`}>{m.name ?? m.login}</a>
                <small>{[m.role, m.codeOwner ? 'code owner' : null].filter(Boolean).join(' · ') || `@${m.login}`}</small>
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p>
          No maintainers are listed yet. The list is read from
          <a href={`${REPO_URL}/blob/main/MAINTAINERS.md`}>MAINTAINERS.md</a>.
        </p>
      )
    }
    <p>
      <a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>How to contribute</a> ·
      <a href={`${REPO_URL}/issues`}>Issues</a> ·
      <a href={`${REPO_URL}/discussions`}>Discussions</a>
    </p>
  </div>
</section>

<script>
  const box = document.querySelector<HTMLElement>('[data-community]');
  if (box) {
    const repo = box.dataset.repo!;
    const setStat = (name: string, value: string | number) => {
      const el = box.querySelector(`[data-stat="${name}"]`);
      if (el) el.textContent = String(value);
    };
    const get = async (path: string) => {
      const response = await fetch(`https://api.github.com/repos/${repo}${path}`, {
        headers: { Accept: 'application/vnd.github+json' },
        credentials: 'omit',
        referrerPolicy: 'no-referrer',
      });
      if (!response.ok) throw new Error(String(response.status));
      return response.json();
    };
    (async () => {
      try {
        const [info, contributors] = await Promise.all([get(''), get('/contributors?per_page=100')]);
        setStat('stars', info.stargazers_count);
        setStat('forks', info.forks_count);
        setStat('issues', info.open_issues_count);
        // /releases (not /releases/latest): the latter answers 404 when there is no release yet
        const releases = await get('/releases?per_page=1').catch(() => null);
        if (releases) setStat('release', releases[0]?.tag_name ?? 'none yet');
        const list = document.getElementById('contributors');
        const known = new Map<string, HTMLElement>();
        list?.querySelectorAll<HTMLElement>('[data-login]').forEach((li) => known.set(li.dataset.login!, li));
        for (const c of contributors as { login: string; type: string; contributions: number; html_url: string }[]) {
          if (c.type === 'Bot' || /\[bot\]$/i.test(c.login)) continue;
          const li = known.get(c.login);
          const count = li?.querySelector('[data-count]');
          if (count) count.textContent = String(c.contributions);
          else if (list) {
            // new since the last build: shown with an initial until the next build copies the avatar
            const item = document.createElement('li');
            item.className = 'lp-person';
            item.dataset.login = c.login;
            const ph = document.createElement('span');
            ph.className = 'ph';
            ph.setAttribute('aria-hidden', 'true');
            ph.textContent = c.login.slice(0, 1).toUpperCase();
            const text = document.createElement('span');
            const link = document.createElement('a');
            link.href = c.html_url;
            link.textContent = c.login;
            const small = document.createElement('small');
            small.textContent = `${c.contributions} contributions`;
            text.append(link, small);
            item.append(ph, text);
            list.append(item);
          }
        }
        const stamp = document.getElementById('community-updated');
        if (stamp) {
          stamp.setAttribute('datetime', new Date().toISOString());
          stamp.textContent = `${new Date().toISOString().slice(0, 16).replace('T', ' ')} UTC (live)`;
        }
      } catch {
        // rate-limited or offline: the build-time values stay
      }
    })();
  }
</script>
